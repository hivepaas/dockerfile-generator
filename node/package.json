{
  "name": "dockerfile-gen",
  "version": "0.5.1",
  "config": {
    "bin_version": "0.5.1"
  },
  "description": "Autogenerate Dockerfiles from your project source code",
  "main": "index.js",
  "bin": {
    "dockerfile-gen": "./bin/dockerfile-gen"
  },
  "scripts": {
    "postinstall": "node install.js"
