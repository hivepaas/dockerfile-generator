    "docker",
    "dockerfile",
    "dockerfile-generator",
    "dockerfile-generator-cli",
    "dockerfile-generator-tool",
    "generate-dockerfile",
    "autogenerate-dockerfile"
  ],
  "author": "Jared Lunde",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hivepaas/dockerfile-generator/issues"
  },
